datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  senha     String
  nome      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  logs      LogAdmin[]
}

model Rifa {
  id                 Int             @id @default(autoincrement())
  titulo             String
  descricao          String
  regulamento        String
  valorPorNumero     Float
  quantidadeTotal    Int          // e.g. 100, 1000, 10000, 100000
  dataSorteio        DateTime?
  status             String          @default("ATIVO") // ATIVO, ENCERRADO, FINALIZADO
  metodoSorteio      String          @default("AVULSO") // LOTERIA_FEDERAL, MANUAL, AUTOMATICO
  resultado          String?         // Vencedor(es), ex: "456"
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  imagens            ImagemRifa[]
  combos             Combo[]
  itensPedido        ItemPedido[]
  ganhadores         Ganhador[]
  sorteios           Sorteio[]
  bilhetes           NumeroBilhete[]

  @@index([status])
  @@index([createdAt])
}

model ImagemRifa {
  id          Int      @id @default(autoincrement())
  rifaId      Int
  rifa        Rifa     @relation(fields: [rifaId], references: [id], onDelete: Cascade)
  url         String
  isPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([rifaId])
}

model Combo {
  id         Int      @id @default(autoincrement())
  rifaId     Int
  rifa       Rifa     @relation(fields: [rifaId], references: [id], onDelete: Cascade)
  nome       String
  quantidade Int
  desconto   Float
  valorFinal Float
  createdAt  DateTime @default(now())

  @@index([rifaId])
}

model Comprador {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String   @unique
  cidade    String
  estado    String
  cpf       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidos   Pedido[]

  @@index([telefone])
  @@index([createdAt])
}

model Pedido {
  id           Int             @id @default(autoincrement())
  hash         String          @unique
  compradorId  Int
  comprador    Comprador       @relation(fields: [compradorId], references: [id])
  status       String          @default("PENDENTE") // PENDENTE, PAGO, CANCELADO
  valorTotal   Float
  pixQrCode    String?         // QR code base64 or payload
  pixCopiaCola String?         // PIX em formato texto
  pixTxid      String?         // ID da transação no gateway
  gatewayMeta  String?         // Metadata JSON do gateway
  expiracaoPix DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  itens        ItemPedido[]
  bilhetes     NumeroBilhete[]

  @@index([compradorId])
  @@index([status])
  @@index([createdAt])
  @@index([pixTxid])
}

model ItemPedido {
  id             Int      @id @default(autoincrement())
  pedidoId       Int
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  rifaId         Int
  rifa           Rifa     @relation(fields: [rifaId], references: [id])
  numeros        String   // Serialized comma-separated e.g. "005,123,099"
  quantidade     Int
  valorUnitario  Float
  createdAt      DateTime @default(now())

  @@index([pedidoId])
  @@index([rifaId])
}

model Ganhador {
  id             Int      @id @default(autoincrement())
  rifaId         Int
  rifa           Rifa     @relation(fields: [rifaId], references: [id], onDelete: Cascade)
  nome           String
  cidade         String
  estado         String
  numeroPremiado String
  dataSorteio    DateTime @default(now())
  fotoPremioUrl  String?
  fotoEntregaUrl String?
  depoimento     String?
  createdAt      DateTime @default(now())
  sorteioId      Int?
  sorteio        Sorteio? @relation(fields: [sorteioId], references: [id], onDelete: SetNull)

  @@index([rifaId])
  @@index([sorteioId])
}

model Configuracao {
  id        Int      @id @default(autoincrement())
  chave     String   @unique
  valor     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chave])
}

model GatewayPagamento {
  id          Int      @id @default(autoincrement())
  nome        String   // e.g. "MercadoPago", "Asaas", "EFI", "Manual"
  ambiente    String   @default("SANDBOX") // SANDBOX, PRODUCTION
  credenciais String   // Serialized JSON or encrypted text
  taxaFixa    Float    @default(0.0)
  taxaPercent Float    @default(0.0)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ativo])
}

model Sorteio {
  id              Int        @id @default(autoincrement())
  rifaId          Int
  rifa            Rifa       @relation(fields: [rifaId], references: [id], onDelete: Cascade)
  tituloSorteio   String     // e.g. "1º Prêmio - Loteria Federal"
  dataSorteioReal DateTime?
  numeroGanhador  String?    // e.g. "456321"
  status          String     @default("PENDENTE") // PENDENTE, REALIZADO, CANCELADO
  dadosExtras     String?    // JSON payload of Federal Lottery or external data
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  ganhadores      Ganhador[]

  @@index([rifaId])
  @@index([status])
}

model LogAdmin {
  id        Int      @id @default(autoincrement())
  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao      String   // e.g. "CREATE_RIFA", "UPDATE_CONFIG", "APPROVE_PIX"
  detalhes  String   // JSON string or text message explaining details
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([acao])
  @@index([createdAt])
}

model Arquivo {
  id           Int      @id @default(autoincrement())
  nomeOriginal String
  nomeUnico    String   @unique
  mimeType     String
  tamanho      Int      // in bytes
  url          String
  bucket       String?  // local / s3 / firebase
  createdAt    DateTime @default(now())

  @@index([nomeUnico])
}

model NumeroBilhete {
  id            Int      @id @default(autoincrement())
  rifaId        Int
  rifa          Rifa     @relation(fields: [rifaId], references: [id], onDelete: Cascade)
  pedidoId      Int
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  numero        String   // e.g. "005", "1234"
  status        String   @default("RESERVADO") // RESERVADO, PAGO
  expiraEm      DateTime // Expiration timestamp for reservations
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([rifaId, numero]) // THE ULTIMATE DOUBLE-BOOKING PREVENTION
  @@index([pedidoId])
  @@index([rifaId, status])
  @@index([expiraEm, status])
}
