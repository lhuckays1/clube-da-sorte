generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  senha     String
  nome      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  logs      LogAdmin[]
}

model Rifa {
  id              Int             @id @default(autoincrement())
  titulo          String
  descricao       String
  regulamento     String
  valorPorNumero  Float
  quantidadeTotal Int
  dataSorteio     DateTime?
  status          String          @default("ATIVO")
  metodoSorteio   String          @default("AVULSO")
  resultado       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  combos          Combo[]
  ganhadores      Ganhador[]
  imagens         ImagemRifa[]
  itensPedido     ItemPedido[]
  bilhetes        NumeroBilhete[]
  sorteios        Sorteio[]

  @@index([status])
  @@index([createdAt])
}

model ImagemRifa {
  id          Int      @id @default(autoincrement())
  rifaId      Int
  url         String
  isPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  rifa        Rifa     @relation(fields: [rifaId], references: [id], onDelete: Cascade)

  @@index([rifaId])
}

model Combo {
  id         Int      @id @default(autoincrement())
  rifaId     Int
  nome       String
  quantidade Int
  desconto   Float
  valorFinal Float
  createdAt  DateTime @default(now())
  rifa       Rifa     @relation(fields: [rifaId], references: [id], onDelete: Cascade)

  @@index([rifaId])
}

model Comprador {
  id        Int      @id @default(autoincrement())
  nome      String
  telefone  String   @unique
  cidade    String
  estado    String
  cpf       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pedidos   Pedido[]

  @@index([telefone])
  @@index([createdAt])
}

model Pedido {
  id           Int             @id @default(autoincrement())
  hash         String          @unique
  compradorId  Int
  status       String          @default("PENDENTE")
  valorTotal   Float
  pixQrCode    String?
  pixCopiaCola String?
  pixTxid      String?
  gatewayMeta  String?
  expiracaoPix DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  itens        ItemPedido[]
  bilhetes     NumeroBilhete[]
  comprador    Comprador       @relation(fields: [compradorId], references: [id])

  @@index([compradorId])
  @@index([status])
  @@index([createdAt])
  @@index([pixTxid])
}

model ItemPedido {
  id            Int      @id @default(autoincrement())
  pedidoId      Int
  rifaId        Int
  numeros       String
  quantidade    Int
  valorUnitario Float
  createdAt     DateTime @default(now())
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  rifa          Rifa     @relation(fields: [rifaId], references: [id])

  @@index([pedidoId])
  @@index([rifaId])
}

model Ganhador {
  id             Int      @id @default(autoincrement())
  rifaId         Int
  nome           String
  cidade         String
  estado         String
  numeroPremiado String
  dataSorteio    DateTime @default(now())
  fotoPremioUrl  String?
  fotoEntregaUrl String?
  depoimento     String?
  createdAt      DateTime @default(now())
  sorteioId      Int?
  rifa           Rifa     @relation(fields: [rifaId], references: [id], onDelete: Cascade)
  sorteio        Sorteio? @relation(fields: [sorteioId], references: [id])

  @@index([rifaId])
  @@index([sorteioId])
}

model Configuracao {
  id        Int      @id @default(autoincrement())
  chave     String   @unique
  valor     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chave])
}

model GatewayPagamento {
  id          Int      @id @default(autoincrement())
  nome        String
  ambiente    String   @default("SANDBOX")
  credenciais String
  taxaFixa    Float    @default(0.0)
  taxaPercent Float    @default(0.0)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ativo])
}

model Sorteio {
  id              Int        @id @default(autoincrement())
  rifaId          Int
  tituloSorteio   String
  dataSorteioReal DateTime?
  numeroGanhador  String?
  status          String     @default("PENDENTE")
  dadosExtras     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  ganhadores      Ganhador[]
  rifa            Rifa       @relation(fields: [rifaId], references: [id], onDelete: Cascade)

  @@index([rifaId])
  @@index([status])
}

model LogAdmin {
  id        Int      @id @default(autoincrement())
  usuarioId Int?
  acao      String
  detalhes  String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([acao])
  @@index([createdAt])
}

model Arquivo {
  id           Int      @id @default(autoincrement())
  nomeOriginal String
  nomeUnico    String   @unique
  mimeType     String
  tamanho      Int
  url          String
  bucket       String?
  createdAt    DateTime @default(now())

  @@index([nomeUnico])
}

model NumeroBilhete {
  id        Int      @id @default(autoincrement())
  rifaId    Int
  pedidoId  Int
  numero    String
  status    String   @default("RESERVADO")
  expiraEm  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  rifa      Rifa     @relation(fields: [rifaId], references: [id], onDelete: Cascade)

  @@unique([rifaId, numero])
  @@index([pedidoId])
  @@index([rifaId, status])
  @@index([expiraEm, status])
}
