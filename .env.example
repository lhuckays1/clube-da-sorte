# APP_URL: The URL where this app is hosted.
APP_URL="https://clubedasorte.athomoinfotech.com.br"

# DATABASE_URL: Prisma database connection string for PostgreSQL.
DATABASE_URL="postgresql://clubedasorte_user:CHANGE_ME@127.0.0.1:5432/clubedasorte_test?schema=public"

# JWT_SECRET: Secret key for signing JSON Web Tokens for admin access
JWT_SECRET="CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"

# Payment provider webhook authentication/secrets (do not commit real values)
ASAAS_WEBHOOK_TOKEN="CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ASAAS_API_KEY=""
ASAAS_ENV="SANDBOX"
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_TOKEN=""
ALLOW_MOCK_PAYMENTS="false"
HOST="127.0.0.1"
